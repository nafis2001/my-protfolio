---
import Layout from '../layouts/Layout.astro';
import Poster from '../components/Poster.astro';
import Gallery from '../components/Gallery.astro';
---

<Layout title="Visual ideas that refuse to blend in">
  <section class="hero wrap">
    <div class="hero-kicker mono">
      <span>INDEPENDENT VISUAL DESIGNER</span>
      <span>QUIET STRUCTURE. LOUD IDEAS.</span>
    </div>
    <h1 class="hero-name">
      NAFIS<span>.</span>
    </h1>
    <div class="hero-grid">
      <div class="hero-copy">
        <span class="eyebrow mono">A LITTLE CLARITY. A LOT OF CHARACTER.</span>
        <h2>
          Visual ideas that
          <br />
          refuse to <em>blend in.</em>
        </h2>
        <p>
          I’m Nafis, an independent multidisciplinary graphic designer in Bangladesh. I make bold
          identities, expressive campaigns, and visuals with something to say.
        </p>
        <div class="actions">
          <a class="button" href="/work">
            Explore my work <span>↗</span>
          </a>
          <a class="text-link" href="/contact">
            Let’s collaborate ↗
          </a>
        </div>
        <span class="hero-index mono">SCROLL TO LOOK CLOSER ↓</span>
      </div>
      <a class="hero-art" href="/lab" aria-label="Explore the interactive Blue Room">
        <Poster />
        <span class="art-caption mono">AN INTERACTIVE TYPE EXPERIMENT — TRY IT ↗</span>
      </a>
    </div>
  </section>
  <div class="ticker" aria-label="Identity, campaigns, packaging, type and motion">
    <span>IDENTITY ↗ CAMPAIGNS ↗ PACKAGING ↗ TYPE ↗ MOTION ↗</span>
  </div>
  <section class="section wrap" id="selected">
    <div class="section-heading">
      <div>
        <span class="eyebrow mono">01 / THE WORK</span>
        <h2>
          Attention,
          <br />
          <em>with intention.</em>
        </h2>
      </div>
      <p>
        A space for visual identities, campaigns, and experiments. Each project deserves its own
        shape.
      </p>
    </div>
    <Gallery />
  </section>
  <section class="approach section">
    <div class="wrap approach-grid">
      <span class="eyebrow mono">02 / THE WAY I SEE IT</span>
      <div>
        <h2>
          Good design gets noticed.
          <br />
          <em>Great design says something.</em>
        </h2>
        <p>
          I care about the idea behind the image. What should someone feel, understand, or do? That
          question shapes the type, the colour, and every deliberate detail.
        </p>
        <a class="text-link" href="/about">
          A little more about me ↗
        </a>
      </div>
      <span class="big-star" aria-hidden="true">
        ✳
      </span>
    </div>
  </section>
  <section class="section wrap lab-teaser">
    <div>
      <span class="eyebrow mono">03 / SERIOUSLY PLAYFUL</span>
      <h2>
        Welcome to
        <br />
        The <em>Blue Room.</em>
      </h2>
      <p>
        A small space for big type. Make a poster, break the composition, find something unexpected.
        Take your creation with you.
      </p>
      <a class="button" href="/lab">
        Make something blue ↗
      </a>
    </div>
    <a href="/lab" class="lab-tile" aria-label="Open The Blue Room">
      <span class="mono">YOUR NEXT HAPPY ACCIDENT</span>
      <strong>
        PLAY
        <br />
        IS A<br />
        <i>PROCESS.</i>
      </strong>
      <span>↗</span>
    </a>
  </section>
</Layout>
